# Plugins outside of this source tree (see PLUGINS.md).
#
#   cmake ... -DUBOROS_PLUGINS_DIR="/path/to/plugin;/path/to/other"
#
# Every folder has a plugin.cmake that calls uboros_add_plugin(). Without the
# option nothing is added to the app: no source, no QML, no Java, no define.
# Included after the target mixxx-qml-lib exists (CMakeLists.txt).

set(UBOROS_PLUGINS_DIR "" CACHE STRING
  "Folders (separated by ;) of plugins to build into the app; each has a plugin.cmake")
set(UBOROS_APPLICATION_ID "" CACHE STRING
  "Android: applicationId of the APK when it must differ from the normal app (installs next to it)")

define_property(GLOBAL PROPERTY UBOROS_PLUGIN_IDS BRIEF_DOCS "plugins" FULL_DOCS "plugin ids")
define_property(GLOBAL PROPERTY UBOROS_PLUGIN_JAVA_DIRS BRIEF_DOCS "java" FULL_DOCS "java dirs")
define_property(GLOBAL PROPERTY UBOROS_PLUGIN_GRADLE_FILES BRIEF_DOCS "gradle" FULL_DOCS "gradle files")

# uboros_add_plugin(NAME <id>
#     SOURCES <c++ files, relative to the plugin folder>
#     [LIBRARIES <targets/libs>] [DEFINITIONS <defs>]
#     [QML_DIR <folder>]            copied to assets/qml/Plugins/<id> (Android)
#     [ASSETS_DIR <folder>]         merged into the root of the assets (e.g. images/library/ic_library_<id>.svg)
#     [ANDROID_JAVA_DIR <folder>]   extra Java sources of the APK
#     [ANDROID_GRADLE <file>])      Gradle file applied to the APK (dependencies...)
# The C++ must define  mixxx::plugins::Plugin* uborosCreatePlugin_<id>();
function(uboros_add_plugin)
  cmake_parse_arguments(P "" "NAME;QML_DIR;ASSETS_DIR;ANDROID_JAVA_DIR;ANDROID_GRADLE"
    "SOURCES;LIBRARIES;DEFINITIONS" ${ARGN})
  if(NOT P_NAME)
    message(FATAL_ERROR "uboros_add_plugin: NAME is required")
  endif()
  set(_sources "")
  foreach(_s IN LISTS P_SOURCES)
    if(NOT IS_ABSOLUTE "${_s}")
      set(_s "${UBOROS_PLUGIN_DIR}/${_s}")
    endif()
    list(APPEND _sources "${_s}")
  endforeach()
  target_sources(mixxx-qml-lib PRIVATE ${_sources})
  target_include_directories(mixxx-qml-lib PRIVATE "${UBOROS_PLUGIN_DIR}")
  if(P_LIBRARIES)
    target_link_libraries(mixxx-qml-lib PUBLIC ${P_LIBRARIES})
  endif()
  if(P_DEFINITIONS)
    target_compile_definitions(mixxx-qml-lib PUBLIC ${P_DEFINITIONS})
  endif()
  target_compile_definitions(mixxx-qml-lib PUBLIC UBOROS_HAS_PLUGINS)
  if(P_QML_DIR AND ANDROID)
    if(NOT IS_ABSOLUTE "${P_QML_DIR}")
      set(P_QML_DIR "${UBOROS_PLUGIN_DIR}/${P_QML_DIR}")
    endif()
    add_custom_command(
      TARGET copy-resource-android
      POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E copy_directory "${P_QML_DIR}"
        "${CMAKE_BINARY_DIR}/android-build/assets/qml/Plugins/${P_NAME}"
    )
  endif()
  if(P_ASSETS_DIR AND ANDROID)
    if(NOT IS_ABSOLUTE "${P_ASSETS_DIR}")
      set(P_ASSETS_DIR "${UBOROS_PLUGIN_DIR}/${P_ASSETS_DIR}")
    endif()
    add_custom_command(
      TARGET copy-resource-android
      POST_BUILD
      COMMAND ${CMAKE_COMMAND} -E copy_directory "${P_ASSETS_DIR}"
        "${CMAKE_BINARY_DIR}/android-build/assets"
    )
  endif()
  if(P_ANDROID_JAVA_DIR)
    if(NOT IS_ABSOLUTE "${P_ANDROID_JAVA_DIR}")
      set(P_ANDROID_JAVA_DIR "${UBOROS_PLUGIN_DIR}/${P_ANDROID_JAVA_DIR}")
    endif()
    set_property(GLOBAL APPEND PROPERTY UBOROS_PLUGIN_JAVA_DIRS "${P_ANDROID_JAVA_DIR}")
  endif()
  if(P_ANDROID_GRADLE)
    if(NOT IS_ABSOLUTE "${P_ANDROID_GRADLE}")
      set(P_ANDROID_GRADLE "${UBOROS_PLUGIN_DIR}/${P_ANDROID_GRADLE}")
    endif()
    set_property(GLOBAL APPEND PROPERTY UBOROS_PLUGIN_GRADLE_FILES "${P_ANDROID_GRADLE}")
  endif()
  set_property(GLOBAL APPEND PROPERTY UBOROS_PLUGIN_IDS "${P_NAME}")
  message(STATUS "Uboros plugin: ${P_NAME} (${UBOROS_PLUGIN_DIR})")
endfunction()

foreach(_dir IN LISTS UBOROS_PLUGINS_DIR)
  if(NOT EXISTS "${_dir}/plugin.cmake")
    message(FATAL_ERROR "UBOROS_PLUGINS_DIR: ${_dir}/plugin.cmake not found")
  endif()
  set(UBOROS_PLUGIN_DIR "${_dir}")
  include("${_dir}/plugin.cmake")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_dir}/plugin.cmake")
endforeach()

get_property(_ids GLOBAL PROPERTY UBOROS_PLUGIN_IDS)
if(_ids)
  set(_decl "")
  set(_calls "")
  foreach(_id IN LISTS _ids)
    string(APPEND _decl "mixxx::plugins::Plugin* uborosCreatePlugin_${_id}();\n")
    string(APPEND _calls "    host.add(uborosCreatePlugin_${_id}());\n")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/uboros_plugins_generated.cpp.tmp"
"// generated by cmake/UborosPlugins.cmake: do not edit
#include \"plugins/pluginhost.h\"

${_decl}
namespace mixxx {
namespace plugins {
void registerBuiltinPlugins(PluginHost& host) {
${_calls}}
} // namespace plugins
} // namespace mixxx
")
  # touch the real file only when the content changes (no useless rebuild)
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_BINARY_DIR}/uboros_plugins_generated.cpp.tmp"
    "${CMAKE_BINARY_DIR}/uboros_plugins_generated.cpp")
  target_sources(mixxx-qml-lib PRIVATE "${CMAKE_BINARY_DIR}/uboros_plugins_generated.cpp")
endif()

# Gradle side (Android): the file is always written, empty without plugins, so that
# a build without plugins never keeps what an earlier build with them left there.
if(ANDROID)
  set(_gradle "// generated by cmake/UborosPlugins.cmake: do not edit\n")
  if(UBOROS_APPLICATION_ID)
    string(APPEND _gradle "android.defaultConfig.applicationId = '${UBOROS_APPLICATION_ID}'\n")
  endif()
  get_property(_java GLOBAL PROPERTY UBOROS_PLUGIN_JAVA_DIRS)
  foreach(_d IN LISTS _java)
    string(APPEND _gradle "android.sourceSets.main.java.srcDirs += ['${_d}']\n")
  endforeach()
  get_property(_gfiles GLOBAL PROPERTY UBOROS_PLUGIN_GRADLE_FILES)
  foreach(_f IN LISTS _gfiles)
    string(APPEND _gradle "apply from: '${_f}'\n")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/android-build/uboros-plugins.gradle.tmp" "${_gradle}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "${CMAKE_BINARY_DIR}/android-build/uboros-plugins.gradle.tmp"
    "${CMAKE_BINARY_DIR}/android-build/uboros-plugins.gradle")
endif()
